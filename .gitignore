node_modules/
ui/dist/*
!ui/dist/.gitkeep

# Python bytecode
__pycache__/

# M2 real-credential harness state (lab only, never commit)
.harness/

# Playwright E2E evidence output (e2e/): HTML reports, traces, screenshots
playwright-report/
test-results/

# Emulator pass output (e2e/emulator): screenshots, results.json, reports
e2e/emulator/out/
