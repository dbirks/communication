*.zip

# Browser verification output (Playwright CLI)
.playwright-cli/
verify-*.png
*.webp
*.jpeg

# Local secrets
.env

# Build and test output
coverage/
/dist/
bin/

# Frontend (ui/ is the Vite SPA; ui/dist is embedded build output, keep only
