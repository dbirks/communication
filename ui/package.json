{
  "name": "communication-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen:api": "node scripts/gen-api.mjs",
    "gen:api:check": "node scripts/gen-api.mjs --check",
    "build": "tsc -b && vite build",
    "postbuild": "node -e \"require('fs').writeFileSync('dist/.gitkeep','')\"",
    "test": "vitest run",
    "lint": "oxlint",
    "check:testids": "node scripts/check-testids.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "check": "pnpm gen:api:check && pnpm lint && pnpm fmt:check && pnpm typecheck && pnpm check:testids && pnpm check:tokens && pnpm test && pnpm build"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@fontsource/kaisei-opti": "5.3.1",
    "@fontsource/red-hat-mono": "5.3.0",
    "@fontsource/red-hat-text": "5.3.0",
    "@tanstack/react-query": "5.104.2",
    "@xyflow/react": "12.12.0",
    "lucide-react": "1.54.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "packageManager": "pnpm@11.28.5"
}
