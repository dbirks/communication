#
# api/Caddyfile — dev/test load balancer for the M1 two-replica stack
# (compose service `lb`, published as http://localhost:18080).
#
# Its only job is to prove replica independence: successive identical requests
# must be answered alternately by api-a and api-b, which the
# X-Communication-Replica response header makes observable.
#

{
	# Not needed locally; keeps the container from binding the admin endpoint.
	admin off
	log {
		output stderr
		level INFO
	}
}

:80 {
	# Both replicas are stateless — all state is in PostgreSQL — so any
	# request may land on any of them (D-003, ADR-0012).
	reverse_proxy api-a:8080 api-b:8080 {
		lb_policy round_robin

		# SSE (GET /api/v1/projects/{projectId}/events) must stream through
		# unbuffered; -1 flushes every write.
		flush_interval -1

		# Active health checks against liveness, which never touches the
		# database: a replica is pulled from rotation only when the process is
		# wedged. Readiness (schema current, datastore reachable) is reported
		# separately by /api/v1/system/readiness and must not flap the pool.
		health_uri /api/v1/system/health
		health_interval 2s
		health_timeout 2s
		health_status 200

		# Passive checks: a transport error or 5xx takes a replica out briefly
		# so a crashing process does not see every other request fail.
		fail_duration 5s

		# Restart tolerance: a single-replica restart (a redeploy, an OOM kill)
		# otherwise shows the browser a 502 for the seconds the upstream is
		# gone, which reads as "the app is broken" even though the other
		# replica is healthy. Retrying another upstream for a bounded window
		# makes a replica restart invisible to a session — and the statelessness
		# that makes the retry correct (ADR-0012: all state is PostgreSQL, any
		# replica may serve any request) is the same thing that makes it safe
		# for non-idempotent POSTs: the write lands in the database or it does
		# not, and a second replica answering the same request is the same
		# answer waiting for the same row.
		lb_try_duration 5s
		lb_try_interval 250ms

		# No header_up X-Forwarded-* overrides needed for the dev stack; Caddy
		# adds X-Forwarded-For/Proto by default, and the API trusts
		# X-Forwarded-Proto for its strict origin check.
		#
		# X-Communication-Replica is passed through untouched: Caddy copies
		# every upstream response header except hop-by-hop ones, so the
		# replica label set by internal/api survives the proxy hop.
	}
}

# ── Sandboxed artifact preview origin (ADR-0020 D6) ───────────────────────
#
# A second site on its own published port. What isolates a previewed document
# from the app is NOT the port — a cookie is scoped to a *host* and ignores
# ports, so "a different port isolates cookies" would be false (that is the
# claim this comment used to make; ADR-0020 D6 says outright that a port
# would not remove one). The isolation is a stack of independent layers, of
# which Caddy contributes only the first:
#
#   * the browser arrives at a different **hostname** — the dev stack uses
#     `preview.localhost` (browsers resolve *.localhost to loopback), and the
#     session cookie is set with no Domain attribute (host-only), so it is
#     bound to `localhost` and never sent to `preview.localhost`. In a real
#     deployment this becomes a distinct preview hostname under the
#     deployment's domain; a deployment that ever sets a cookie with a Domain
#     attribute wide enough to cover both origins has lost the cookie half of
#     the isolation and must treat the CSP layer as the only one left.
#   * the Go handler deletes any Cookie header that arrives anyway
#     (internal/api/artifact_preview.go), so a proxy misconfiguration cannot
#     hand the preview document a session it was never meant to see.
#   * every preview response carries `Content-Security-Policy: sandbox`, an
#     opaque origin whose script can read neither the embedder's DOM nor any
#     cookie, and whose fetches carry no credentials — the layer that holds
#     even when the two above are argued about. It is set by the handler,
#     not here.
#
# The control plane also refuses non-/preview paths on this host
# (api.PreviewHostOnly); together with the missing /api route and the missing
# static file server below, the SPA shell is unreachable on this origin by
# three independent means.
#
# Preview traffic pins to api-a rather than joining the round-robin above:
# every replica shares one signing key (compose mounts it on both, generated
# by keyring-init), so the pin is an availability choice — a wedged preview
# should fail visibly rather than be re-served behind a health check this
# block does not run — and never a correctness one. Tokens minted by api-b
# verify here exactly because the key is shared.
:8084 {
	reverse_proxy api-a:8080 {
		# Same restart tolerance as the app site: one previewed document per
		# navigation, and a 502 here is a blank panel in the UI.
		lb_try_duration 5s
		lb_try_interval 250ms
	}
}
